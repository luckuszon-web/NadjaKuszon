<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ metaTitle or (title + " | Nadja Kuszon") }}</title>
  <meta name="description" content="{{ description }}">
  {%- set canonical = page.url | absoluteUrl(site.url) %}
  <link rel="canonical" href="{{ canonical }}">
  {%- if env.preview %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:site_name" content="Nadja Kuszon">
  <meta property="og:title" content="{{ metaTitle or title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ site.ogImage | absoluteUrl(site.url) }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Nadja Kuszon – astrolog og astrologisk terapi">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#F4EEE3">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Quicksand:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="/assets/css/style.css">
  {%- for s in schema %}
  {% include "schema/" + s + ".njk" %}
  {%- endfor %}
</head>
<body class="{{ bodyClass }}">
  <a class="skip-link" href="#indhold">Spring til indhold</a>

  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-text">
          <span class="brand-name">Nadja Kuszon</span>
          <span class="brand-sub">Astrologisk terapi</span>
        </span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="hovedmenu">
        <span class="nav-toggle-bars" aria-hidden="true"></span>
        <span class="nav-toggle-label">Menu</span>
      </button>
      <nav class="nav" id="hovedmenu" aria-label="Hovedmenu">
        <ul>
          {%- for item in site.nav %}
          {%- set active = (page.url == item.url) or (item.url != "/" and page.url.startsWith(item.url)) %}
          <li><a href="{{ item.url }}"{% if item.button %} class="nav-button"{% endif %}{% if active %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
    </div>
  </header>

  <main id="indhold">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <p class="footer-name">Nadja Kuszon</p>
        <p>Astrologisk terapi og dybdegående horoskoptydning.<br>{{ site.location }}.</p>
      </div>
      <div>
        <h2 class="footer-heading">Kontakt</h2>
        <ul class="footer-list">
          <li>Sms eller ring: <a href="tel:{{ site.phone }}">{{ site.phoneDisplay }}</a></li>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><a href="/kontakt/">Book tid</a></li>
        </ul>
      </div>
      <div>
        <h2 class="footer-heading">Følg mig</h2>
        <ul class="footer-list">
          <li><a href="{{ site.facebook }}" rel="noopener" target="_blank">Facebook</a></li>
          <li><a href="{{ site.linkedin }}" rel="noopener" target="_blank">LinkedIn</a></li>
        </ul>
      </div>
    </div>
    <div class="container footer-legal">
      <p>{{ site.legalName }} · CVR {{ site.cvr }}</p>
    </div>
  </footer>

  <script src="/assets/js/main.js" defer></script>
</body>
</html>
