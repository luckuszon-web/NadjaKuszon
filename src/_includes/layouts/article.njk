---
layout: layouts/base.njk
schema: []
---
<article class="article">
  <header class="page-hero article-hero">
    <div class="container narrow">
      <p class="breadcrumb"><a href="/inspiration-viden/">Viden &amp; inspiration</a> · <a href="/inspiration-viden/kategori/{{ category }}/">{{ category | categoryName(categories) }}</a></p>
      <h1>{{ title }}</h1>
    </div>
  </header>
  <div class="section article-body">
    <div class="container narrow prose">
      {{ content | safe }}
    </div>
  </div>
  <div class="container narrow article-cta">
    {% include "partials/astro-boks.njk" %}
    <p class="center"><a class="text-link" href="/inspiration-viden/kategori/{{ category }}/">Flere artikler om {{ category | categoryName(categories) | lower }}</a></p>
  </div>
</article>
